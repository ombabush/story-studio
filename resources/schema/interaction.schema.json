{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ombabush:story-interaction:1.0-draft.1",
  "title": "Story Interaction Profile 1.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "story-interaction/1.0-draft.1"
    },
    "storyId": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 1,
      "maxItems": 5000
    }
  },
  "required": [
    "profile",
    "storyId",
    "revision",
    "language",
    "assets",
    "cards",
    "pages"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "localized": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rect"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "ellipse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ellipse"
        },
        "cx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "cy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "rx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "ry": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "cx",
        "cy",
        "rx",
        "ry"
      ]
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 512
        }
      },
      "required": [
        "type",
        "points"
      ]
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "path"
        },
        "d": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "fillRule": {
          "enum": [
            "nonzero",
            "evenodd"
          ]
        }
      },
      "required": [
        "type",
        "d",
        "fillRule"
      ]
    },
    "shape": {
      "oneOf": [
        {
          "$ref": "#/$defs/rect"
        },
        {
          "$ref": "#/$defs/ellipse"
        },
        {
          "$ref": "#/$defs/polygon"
        },
        {
          "$ref": "#/$defs/path"
        }
      ]
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "^assets/[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40000
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "mediaType",
        "width",
        "height"
      ]
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240,
          "pattern": "^assets/[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "enum": [
            "audio/mpeg",
            "audio/ogg",
            "audio/mp4",
            "video/mp4"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "mediaType"
      ]
    },
    "asset": {
      "oneOf": [
        {
          "$ref": "#/$defs/imageAsset"
        },
        {
          "$ref": "#/$defs/mediaAsset"
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "character",
            "object",
            "place",
            "note",
            "reference"
          ]
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "body": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "propertyNames": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "imageAssetId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ]
    },
    "jump": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "jump"
        },
        "pageId": {
          "$ref": "#/$defs/id"
        },
        "anchorId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "pageId"
      ]
    },
    "openCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "open-card"
        },
        "cardId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "cardId"
      ]
    },
    "openUrl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "open-url"
        },
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "playMedia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "play-media"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "assetId"
      ]
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/jump"
        },
        {
          "$ref": "#/$defs/openCard"
        },
        {
          "$ref": "#/$defs/openUrl"
        },
        {
          "$ref": "#/$defs/playMedia"
        }
      ]
    },
    "regionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "region"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "outline": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "type",
        "shape"
      ]
    },
    "textAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text"
        },
        "blockId": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "blockId",
        "runId"
      ]
    },
    "anchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/regionAnchor"
        },
        {
          "$ref": "#/$defs/textAnchor"
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredEffect": {
          "enum": [
            "outline",
            "brackets",
            "ink",
            "quiet",
            "spotlight",
            "soft-focus",
            "halo",
            "lift",
            "duotone"
          ]
        },
        "strength": {
          "enum": [
            "subtle",
            "normal"
          ]
        }
      },
      "required": []
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "nav",
            "character",
            "object",
            "place",
            "note",
            "media",
            "reference"
          ]
        },
        "label": {
          "$ref": "#/$defs/localized"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "importance": {
          "enum": [
            "supplementary",
            "essential"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "groupId": {
          "$ref": "#/$defs/id"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "anchor",
        "action"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/localized"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          },
          "minItems": 1,
          "maxItems": 2000
        }
      },
      "required": [
        "id",
        "runs"
      ]
    },
    "pageAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "id",
        "shape"
      ]
    },
    "surface": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assetId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "assetId"
          ]
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pageAnchor"
          },
          "minItems": 0,
          "maxItems": 512
        },
        "textBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 0,
          "maxItems": 512
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "protectedAreas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "id",
        "surface",
        "interactions"
      ]
    }
  }
}
